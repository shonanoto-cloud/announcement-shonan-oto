---
const today = new Date();
---

<footer class="site-footer">
	<div class="scan-line"></div>
	
	<div class="footer-content">
		<p class="copyright">
			<span class="system-status">SYS_STATUS: ONLINE</span><br>
			&copy; {today.getFullYear()} shonan_oto. All rights reserved.
		</p>
		
		<div class="social-links">
			<a href="https://twitter.com/shonan_oto" target="_blank" rel="noopener noreferrer" aria-label="Follow me on Twitter">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path> 
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		padding: 60px 40px; /* PCで映えるゆとりのある上下幅 */
		background-color: #0a0f1a; /* ヘッダーの宇宙ドック風ブラックに統一 */
		border-top: 1px solid rgba(0, 128, 36, 0.2);
		color: #4f5b70;
		overflow: hidden;
		font-family: monospace;
	}
	
	/* --- SFアニメーション: スキャンライン --- */
	.scan-line {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			to bottom,
			rgba(0, 255, 71, 0) 0%,
			rgba(0, 255, 71, 0.03) 10%,
			rgba(0, 255, 71, 0) 20%
		);
		background-size: 100% 500px;
		animation: vhsScan 8s linear infinite;
		pointer-events: none;
	}

	.footer-content {
		max-width: 1400px; /* パソコン画面いっぱいに広がるコンテナ */
		margin: 0 auto;
		display: flex;
		flex-direction: row; /* 横並びに変更して「中央寄りすぎ」を解消 */
		justify-content: space-between;
		align-items: center;
	}
	
	.system-status {
		color: #008024;
		font-size: 0.75rem;
		font-weight: bold;
		letter-spacing: 1px;
		display: inline-block;
		margin-bottom: 6px;
	}
	.copyright {
		margin: 0;
		font-size: 0.85rem;
		text-align: left; /* 左寄せにして安定感を */
		line-height: 1.5;
	}

	.social-links {
		display: flex;
		gap: 12px;
	}
	.social-links a {
		color: #8892b0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid rgba(0, 128, 36, 0.3);
		background: rgba(10, 15, 26, 0.6);
		transition: all 0.25s ease;
	}
	/* ホバーでネオン化するアイコン */
	.social-links a:hover {
		color: #00ff47;
		border-color: #00ff47;
		box-shadow: 0 0 12px rgba(0, 255, 71, 0.4);
		transform: translateY(-3px);
	}

	/* スキャンラインのアニメーション */
	@keyframes vhsScan {
		0% { background-position: 0 -500px; }
		100% { background-position: 0 500px; }
	}

	/* スマホ等の狭い画面用のレスポンシブ対応 */
	@media (max-width: 768px) {
		.footer-content {
			flex-direction: column;
			gap: 24px;
			text-align: center;
		}
		.copyright {
			text-align: center;
		}
	}
</style>