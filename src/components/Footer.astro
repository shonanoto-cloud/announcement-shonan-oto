---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-content">
		<div class="social-links">
			<a href="https://twitter.com/shonan_oto" target="_blank" rel="noopener noreferrer" aria-label="Follow me on Twitter">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
				</svg>
			</a>
		</div>
		<p class="copyright">&copy; {today.getFullYear()} shonan_oto. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		padding: 48px 24px;
		background-color: #111827; /* ヘッダーの共通ブラックに統一 */
		border-top: 1px solid rgba(255, 255, 255, 0.05); /* 境界線を薄いホワイトに変更 */
		color: #6b7280; /* 文字色は落ち着いたグレー */
	}
	.footer-content {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}
	.social-links {
		display: flex;
		gap: 16px;
	}
	.social-links a {
		color: #9ca3af;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background-color: rgba(255, 255, 255, 0.03);
		transition: all 0.2s ease;
	}
	/* ホバー時にJRグリーンに変化しつつ、少し上に浮き上がるモダンな演出 */
	.social-links a:hover {
		color: #ffffff;
		background-color: #008024;
		transform: translateY(-2px);
	}
	.copyright {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.5px;
	}
</style>