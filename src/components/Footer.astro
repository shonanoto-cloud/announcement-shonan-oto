---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-content">
		<div class="footer-left">
			<div class="status-panel">
				<span class="status-dot"></span>
				<span class="status-text">SECURE_NODE // ONLINE</span>
			</div>
			<p class="copyright">&copy; {today.getFullYear()} shonan_oto. All rights reserved.</p>
		</div>
		
		<div class="social-links">
			<a href="https://twitter.com/shonan_oto" target="_blank" rel="noopener noreferrer" aria-label="Follow me on Twitter">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: 60px 40px;
		background-color: #0b101b; /* ヘッダーと完全に統一 */
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		color: #64748b;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}
	.footer-content {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	
	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.status-panel {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: monospace;
		font-size: 0.75rem;
		color: #38bdf8;
	}
	.status-dot {
		width: 6px;
		height: 6px;
		background-color: #38bdf8;
		border-radius: 50%;
		box-shadow: 0 0 8px #38bdf8;
		animation: pulse 2s infinite;
	}
	.copyright {
		margin: 0;
		font-size: 0.85rem;
		color: #94a3b8; /* 文字を一段階明るくして読みやすく */
	}

	.social-links a {
		color: #94a3b8;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: all 0.2s ease;
	}
	/* ホバーでアンバーに発光 */
	.social-links a:hover {
		color: #ffffff;
		border-color: #f59e0b;
		background: rgba(245, 158, 11, 0.05);
		box-shadow: 0 0 16px rgba(245, 158, 11, 0.2);
		transform: translateY(-2px);
	}

	@keyframes pulse {
		0% { opacity: 0.4; }
		50% { opacity: 1; }
		100% { opacity: 0.4; }
	}

	@media (max-width: 768px) {
		.footer-content {
			flex-direction: column;
			gap: 24px;
			text-align: center;
		}
		.footer-left {
			align-items: center;
		}
	}
</style>