---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header" id="site-header">
	<nav class="header-nav">
		<h2 class="site-title">
			<a href="/" class="logo-link">
				<span class="title-core">{SITE_TITLE}</span>
				<span class="system-tag">0.1.0-α</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			
			<div class="dropdown">
				<HeaderLink href="/audio" class="dropdown-trigger">
					<span class="trigger-text">
						Audio
						<svg class="chevron-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
					</span>
				</HeaderLink>
				<div class="dropdown-menu">
					<div class="menu-label">SELECT DIRECTORY</div>
					<a href="/audio/jreast">
						<span class="link-accent">/</span>JR東日本
					</a>
					<a href="/audio/jreast">
						<span class="link-accent">/</span>JR西日本
					</a>
				</div>
			</div>

			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
	<div class="header-line-bar"></div>
</header>

<script>
	const header = document.getElementById('site-header');
	if (header) {
		window.addEventListener('scroll', () => {
			if (window.scrollY > 20) {
				header.classList.add('scrolled');
			} else {
				header.classList.remove('scrolled');
			}
		});
	}
</script>

<style>
	/* ページ側CSSとの競合を完全ブロック */
	.site-header,
	.site-header * {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		box-sizing: border-box;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0;
		background-color: rgba(11, 16, 27, 0.96);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	
	.site-header.scrolled {
		background-color: rgba(11, 16, 27, 0.85);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
	}
	.site-header.scrolled .header-nav {
		height: 54px;
	}
	.site-header.scrolled .header-line-bar {
		height: 1px;
		opacity: 0.6;
	}

	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 40px;
		height: 72px;
		transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	
	.site-title {
		margin: 0;
	}
	
	/* --- ★ホームページ名（ロゴ）のリンク＆ホバースタイル --- */
	.logo-link {
		display: flex;
		align-items: baseline;
		gap: 8px;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
	}
	.title-core {
		color: #94a3b8; /* 通常時は少し落ち着いたテックグレー（メニューの通常時と同期） */
		font-size: 1.2rem;
		font-weight: 800;
		letter-spacing: 1.5px;
		transition: color 0.25s ease, text-shadow 0.25s ease;
	}
	.system-tag {
		font-family: monospace;
		font-size: 0.65rem;
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.1);
		padding: 2px 6px;
		border-radius: 3px;
		border: 1px solid rgba(56, 189, 248, 0.2);
		transition: all 0.25s ease;
	}

	/* ホームページ名ホバー時：文字が白く覚醒し、サイバー発光する */
	.logo-link:hover .title-core {
		color: #ffffff;
		text-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
	}
	/* タグもホバーでアンバー（警告・起動灯カラー）に変色 */
	.logo-link:hover .system-tag {
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.1);
		border-color: rgba(245, 158, 11, 0.3);
	}

	.internal-links {
		display: flex;
		gap: 8px;
		height: 100%;
		align-items: center;
	}

	.dropdown {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
	}
	.dropdown-trigger {
		display: flex;
		align-items: center;
	}
	.trigger-text {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		white-space: nowrap;
	}
	.chevron-icon {
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		opacity: 0.6;
		flex-shrink: 0;
	}
	.dropdown:hover .chevron-icon {
		transform: rotate(180deg);
		opacity: 1;
	}
	
	.dropdown-menu {
		position: absolute;
		top: 100%; 
		left: 50%;
		width: 200px;
		background: #1e2536;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-top: 2px solid #38bdf8;
		border-radius: 0 0 6px 6px;
		padding: 10px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
		
		opacity: 0;
		transform: translateX(-50%) translateY(4px);
		pointer-events: none;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.dropdown:hover .dropdown-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateX(-50%) translateY(0);
	}
	
	.menu-label {
		font-family: monospace;
		font-size: 0.65rem;
		color: #64748b;
		padding: 4px 8px 8px 8px;
		letter-spacing: 1px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		margin-bottom: 6px;
	}
	
	.dropdown-menu a {
		padding: 10px 12px;
		color: #cbd5e1;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		border-radius: 4px;
		transition: all 0.15s ease;
		display: flex;
		align-items: center;
	}
	.link-accent {
		color: #38bdf8;
		margin-right: 6px;
		font-family: monospace;
		font-weight: bold;
		transition: transform 0.15s ease;
	}
	.dropdown-menu a:hover {
		color: #ffffff;
		background-color: rgba(255, 255, 255, 0.03);
		box-shadow: inset 3px 0 0 #f59e0b;
	}
	.dropdown-menu a:hover .link-accent {
		color: #f59e0b;
		transform: translateX(2px);
	}
	
	/* 最下部のパルスライン */
	.header-line-bar {
		background: linear-gradient(90deg, #38bdf8, #f59e0b, #38bdf8);
		background-size: 200% 100%;
		height: 2px;
		width: 100%;
		opacity: 0.8;
		animation: cyberPulse 6s linear infinite;
		transition: height 0.3s, opacity 0.3s, background 0.3s;
	}

	/* ★ギミック：ロゴにホバーしている間、最下部のラインのパルスが高速化＆アンバー化する */
	.site-header:has(.logo-link:hover) .header-line-bar {
		background: linear-gradient(90deg, #f59e0b, #ffffff, #f59e0b);
		background-size: 200% 100%;
		animation: cyberPulse 1.5s linear infinite; /* 6sから1.5sへ超高速化 */
		opacity: 1;
		box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
	}

	@keyframes cyberPulse {
		0% { background-position: 0% 50%; }
		100% { background-position: 200% 50%; }
	}

	@media (max-width: 640px) {
		.header-nav {
			padding: 0 16px;
		}
		.title-core {
			font-size: 1rem;
		}
		.system-tag {
			display: none;
		}
		.internal-links {
			gap: 2px;
		}
	}
</style>