---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav class="header-nav">
		<h2 class="site-title">
			<span class="title-core">{SITE_TITLE}</span>
			<span class="system-tag">UI_v2.6</span>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			
			<div class="dropdown">
				<HeaderLink href="/audio" class="dropdown-trigger">
					Audio
					<svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
				</HeaderLink>
				<div class="dropdown-menu">
					<div class="menu-label">SELECT DIRECTORY</div>
					<a href="/audio/tracks">
						<span class="link-accent">/</span>音源一覧
					</a>
					<a href="/audio/equipment">
						<span class="link-accent">/</span>収録機材
					</a>
				</div>
			</div>

			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
	<div class="header-line-bar"></div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0;
		background-color: rgba(11, 16, 27, 0.96);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
	}
	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 40px;
		height: 72px;
	}
	.site-title {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 8px;
		font-family: -apple-system, BlinkMacSystemFont, sans-serif;
	}
	.title-core {
		color: #ffffff;
		font-size: 1.2rem;
		font-weight: 800;
		letter-spacing: 1.5px;
	}
	.system-tag {
		font-family: monospace;
		font-size: 0.65rem;
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.1);
		padding: 2px 6px;
		border-radius: 3px;
		border: 1px solid rgba(56, 189, 248, 0.2);
	}

	.internal-links {
		display: flex;
		gap: 8px;
		height: 100%;
		align-items: center;
	}

	/* --- ドロップダウン位置バグ修正 --- */
	.dropdown {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
	}
	.dropdown-trigger {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.chevron-icon {
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		opacity: 0.6;
	}
	.dropdown:hover .chevron-icon {
		transform: rotate(180deg);
		opacity: 1;
	}
	
	.dropdown-menu {
		position: absolute;
		/* 完全にナビゲーションバーの真下に配置（被りを解消） */
		top: 100%; 
		left: 50%;
		width: 200px;
		background: #1e2536;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-top: 2px solid #38bdf8;
		border-radius: 0 0 6px 6px; /* 上はヘッダーに付けるので下だけ丸みに */
		padding: 10px; /* 余白を少し広げて視認性向上 */
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
		
		opacity: 0;
		transform: translateX(-50%) translateY(4px);
		pointer-events: none;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.dropdown:hover .dropdown-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateX(-50%) translateY(0);
	}
	
	.menu-label {
		font-family: monospace;
		font-size: 0.65rem;
		color: #64748b;
		padding: 4px 8px 8px 8px;
		letter-spacing: 1px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		margin-bottom: 6px;
	}
	
	.dropdown-menu a {
		padding: 10px 12px;
		color: #cbd5e1;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		border-radius: 4px;
		transition: all 0.15s ease;
		display: flex;
		align-items: center;
	}
	.link-accent {
		color: #38bdf8;
		margin-right: 6px;
		font-family: monospace;
		font-weight: bold;
		transition: transform 0.15s ease;
	}
	.dropdown-menu a:hover {
		color: #ffffff;
		background-color: rgba(255, 255, 255, 0.03);
		box-shadow: inset 3px 0 0 #f59e0b;
	}
	.dropdown-menu a:hover .link-accent {
		color: #f59e0b;
		transform: translateX(2px);
	}
	
	.header-line-bar {
		background: linear-gradient(90deg, #38bdf8, #f59e0b, #38bdf8);
		background-size: 200% 100%;
		height: 2px;
		width: 100%;
		opacity: 0.8;
		animation: cyberPulse 6s linear infinite;
	}

	@keyframes cyberPulse {
		0% { background-position: 0% 50%; }
		100% { background-position: 200% 50%; }
	}
</style>