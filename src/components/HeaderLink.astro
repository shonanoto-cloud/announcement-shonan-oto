---
import type { HTMLAttributes } from 'astro/types'; 

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, ''); 
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[`cyber-link ${className || ''}`, { active: isActive }]} {...props}>
	<span class="link-text"><slot /></span>
	<span class="glitch-line"></span>
</a>

<style>
	.cyber-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		padding: 0 20px; /* 幅広画面に合わせてゆったり配置 */
		color: #8892b0;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		font-family: monospace;
		position: relative;
		transition: color 0.3s ease;
		overflow: hidden;
	}
	.link-text {
		position: relative;
		z-index: 2;
	}
	/* ホバー時のテキスト発光 */
	.cyber-link:hover {
		color: #00ff47; /* 鮮やかなネオングリーン */
		text-shadow: 0 0 10px rgba(0, 255, 71, 0.6);
	}
	
	/* SFチックな底面アニメーションライン */
	.glitch-line {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: #00ff47;
		box-shadow: 0 0 8px #00ff47;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.cyber-link:hover .glitch-line {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* 現在地（アクティブ）の時の固定表示 */
	.cyber-link.active {
		color: #ffffff;
		font-weight: 800;
	}
	.cyber-link.active .glitch-line {
		transform: scaleX(1);
		background: #008024;
		box-shadow: 0 0 8px rgba(0, 128, 36, 0.8);
	}
</style>