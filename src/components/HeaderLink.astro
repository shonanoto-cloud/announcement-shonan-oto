---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[`menu-link ${className || ''}`, { active: isActive }]} {...props}>
	<span class="link-text"><slot /></span>
	<span class="indicator-line"></span>
</a>

<style>
	.menu-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 100%; /* 親（nav）の高さ変化に完全自動追従 */
		padding: 0 16px; /* スマホを考慮して横幅を少しだけコンパクトに(20px→16px) */
		color: #94a3b8;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		transition: color 0.2s ease;
		position: relative;
	}
	.link-text {
		position: relative;
		z-index: 2;
	}
	
	.menu-link:hover {
		color: #38bdf8;
	}
	
	/* シャープライン・インジケーター */
	.indicator-line {
		position: absolute;
		bottom: 0; /* 常にヘッダーが縮小しても底面に張り付きます */
		left: 12px;
		right: 12px;
		height: 2px;
		background-color: #38bdf8;
		box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
		
		transform: scaleX(0);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	
	.menu-link:hover .indicator-line {
		transform: scaleX(1);
	}
	
	.menu-link.active {
		color: #ffffff;
		font-weight: 700;
	}
	.menu-link.active .indicator-line {
		transform: scaleX(1);
		background-color: #ffffff;
		box-shadow: 0 0 12px rgba(255, 255, 255, 0.9);
	}

	/* スマホ用の文字サイズ微調整 */
	@media (max-width: 640px) {
		.menu-link {
			padding: 0 8px; /* スマホではさらにリンクの余白を詰める */
			font-size: 0.85rem; /* 文字を少し小さくして確実に1行に収める */
		}
		.indicator-line {
			left: 6px;
			right: 6px;
		}
	}
</style>