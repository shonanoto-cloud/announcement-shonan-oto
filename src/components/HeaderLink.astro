---
import type { HTMLAttributes } from 'astro/types'; [cite: 7]

type Props = HTMLAttributes<'a'>; [cite: 7]

const { href, class: className, ...props } = Astro.props; [cite: 7]
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, ''); [cite: 8]
const subpath = pathname.match(/[^\/]+/g); [cite: 8]
const isActive = href === pathname || href === '/' + (subpath?.[0] || ''); [cite: 8, 9]
---

<a href={href} class:list={[`cyber-link ${className || ''}`, { active: isActive }]} {...props}>
	<span class="link-text"><slot /></span>
	<span class="glitch-line"></span>
</a>

<style>
	.cyber-link {
		display: inline-flex; [cite: 9]
		align-items: center; [cite: 9]
		justify-content: center; [cite: 10]
		height: 100%;
		padding: 0 20px; /* 幅広画面に合わせてゆったり配置 */
		color: #8892b0;
		text-decoration: none; [cite: 10]
		font-weight: 700; [cite: 10]
		font-size: 0.9rem; [cite: 10]
		font-family: monospace;
		position: relative; [cite: 11]
		transition: color 0.3s ease;
		overflow: hidden;
	}
	.link-text {
		position: relative;
		z-index: 2;
	}
	/* ホバー時のテキスト発光 */
	.cyber-link:hover {
		color: #00ff47; /* 鮮やかなネオングリーン */
		text-shadow: 0 0 10px rgba(0, 255, 71, 0.6);
	}
	
	/* SFチックな底面アニメーションライン */
	.glitch-line {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: #00ff47;
		box-shadow: 0 0 8px #00ff47;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.cyber-link:hover .glitch-line {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* 現在地（アクティブ）の時の固定表示 */
	.cyber-link.active {
		color: #ffffff; [cite: 11]
		font-weight: 800; [cite: 11]
	}
	.cyber-link.active .glitch-line {
		transform: scaleX(1);
		background: #008024;
		box-shadow: 0 0 8px rgba(0, 128, 36, 0.8);
	}
</style>