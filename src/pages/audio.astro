---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header/>
		<main>
			<h1>Audio</h1>
			<p>ここでは、管理人が収録した駅放送や発車メロディを公開しています。</p>
			<h2>会社別</h2>
			<p>ここでは、鉄道会社別に駅放送を公開しています。</p>
			
			<div class="list">
				<div class="item">
					<img class="item-image" src="/images/saikyo.JPG" alt="JR東日本" />
					<div class="button-container">
						<a href="/audio/jreast" class="btn-styled">JR東日本</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/yamatoji.jpg" alt="JR西日本" />
					<div class="button-container">
						<a href="/audio/jrwest" class="btn-styled">JR西日本</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/ICE2.jpg" alt="DB" />
					<div class="button-container">
						<a href="/audio/DB" class="btn-styled">Deutsche Bahn</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/TM7101.jpg" alt="東京メトロ" />
					<div class="button-container">
						<a href="/audio/tokyometro" class="btn-styled">東京メトロ</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/tobu.jpg" alt="東武鉄道" />
					<div class="button-container">
						<a href="/audio/tobu" class="btn-styled">東武鉄道</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/115-S7.jpg" alt="しなの鉄道" />
					<div class="button-container">
						<a href="/audio/shinatetsu" class="btn-styled">しなの鉄道</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>