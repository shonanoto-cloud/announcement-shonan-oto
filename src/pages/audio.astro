---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header/>
		<main>
			<h1>Audio</h1>
			<p>
				ここでは、管理人が収録した駅放送や発車メロディを公開しています。
			</p>
			<h2>会社別</h2>
			<p>
				ここでは、鉄道会社別に駅放送を公開しています。
			</p>
			<div class="list">
				<div class="item">
					<img class="item-image" src="/images/denentoshi.jpg" />
					<a class="item-link" href="/audio/denentoshi">東急田園都市線</a>
				</div>
				<div class="item">
					<img class="item-image" src="/images/saikyo.JPG" />
					<a class="item-link" href="/audio/saikyo">埼京線</a>
				</div>
				<div class="item">
					<img class="item-image" src="/images/yamatoji2.JPG" />
					<a class="item-link" href="/audio/jrwest">JR西日本</a>
				</div>
				<div class="item">
					<img class="item-image" src="/images/tobu.jpg" />
					<a class="item-link" href="/audio/tobu">東武鉄道</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
