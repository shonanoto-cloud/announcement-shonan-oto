---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`鉄道事業者一覧 | ${SITE_TITLE}`} description="収録している鉄道事業者の一覧ページです。" />
	</head>
	<body>
		<Header />
		<main class="main-container">
			<div class="section-title">鉄道事業者を選択</div>
			
			<div class="flat-list">
				<a href="/audio/jreast" class="flat-card" style="border-left: 6px solid var(--jr-green);">
					<span>JR東日本 (JR East)</span>
					<span style="color: var(--text-sub); font-size: 0.85rem;">選択 ◀</span>
				</a>

				<a href="#" class="flat-card" style="border-left: 6px solid #1c599c; opacity: 0.6;">
					<span>小田急電鉄 (Odakyu)</span>
					<span style="color: var(--text-sub); font-size: 0.8rem;">準備中</span>
				</a>
				<a href="#" class="flat-card" style="border-left: 6px solid #0097a7; opacity: 0.6;">
					<span>江ノ島電鉄 (Enoden)</span>
					<span style="color: var(--text-sub); font-size: 0.8rem;">準備中</span>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>