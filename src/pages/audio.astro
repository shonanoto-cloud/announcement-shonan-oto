---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header/>
		<main>
			<h1>Audio</h1>
			<p>
				ここでは、管理人が収録した駅放送や発車メロディを公開しています。
			</p>
			<h2>会社別</h2>
			<p>
				ここでは、鉄道会社別に駅放送を公開しています。
			</p>
			<div class="list">
				<div class="item">
					<img class="item-image" src="/images/F-5102.jpg" />
					<div class="button008">
						<a href="/audio/jrkita">JR北海道</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/saikyo.JPG" />
					<div class="button008">
						<a href="/audio/jreast">JR東日本</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/yamatoji.jpg" />
					<div class="button008">
						<a href="/audio/jrwest">JR西日本</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/ICE2.jpg" />
					<div class="button008">
						<a href="/audio/DB">Deutsche Bahn</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/TM7101.jpg" />
					<div class="button008">
						<a href="/audio/tokyometro">東京メトロ</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/tobu.jpg" />
					<div class="button008">
						<a href="/audio/tobu">東武鉄道</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/denentoshi.jpg" />
					<div class="button008">
						<a href="/audio/denentoshi">東急電鉄</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/rinkai.JPG" />
					<div class="button008">
						<a href="/audio/rinkai">東京臨海高速鉄道</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/115-S7.jpg" />
					<div class="button008">
						<a href="/audio/shinatetsu">しなの鉄道</a>
					</div>
				</div>
			</div>
		</main>
		<Footer/>
	</body>
</html>
