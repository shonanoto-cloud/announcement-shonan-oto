---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description="JR East" />
	</head>
	<body>
		<Header/>
		<main>
			<h1>JR EAST</h1>
			<p>JR東日本の駅放送を公開しています。</p>
			<h2>路線別</h2>
			<p>以下から路線を選択してください。</p>
			
			<div class="list">
				<div class="item">
					<img class="item-image" src="/images/saikyo.JPG" alt="埼京線" />
					<div class="button-container">
						<a href="/audio/jreast" class="btn-styled">埼京線</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/keyo34.jpg" alt="京葉線" />
					<div class="button-container">
						<a href="/audio/jreast/keiyo" class="btn-styled">京葉線</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/musashino.jpg" alt="武蔵野線" />
					<div class="button-container">
						<a href="/audio/musashino" class="btn-styled">武蔵野線</a>
					</div>
				</div>
				<div class="item">
					<img class="item-image" src="/images/nikko205.jpg" alt="日光線" />
					<div class="button-container">
						<a href="/audio/nikko" class="btn-styled">日光線</a>
					</div>
				</div>
			</div>
		<a href="../" class="btn-app-back">
                会社別へ戻る
        </a>
		</main>
		<Footer />
	</body>
</html>