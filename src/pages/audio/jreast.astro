---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`JR東日本 路線一覧 | ${SITE_TITLE}`} description="JR東日本の路線一覧ページです。" />
	</head>
	<body>
		<Header />
		<main class="main-container">
			<div class="section-title">JR東日本 路線一覧</div>
			
			<div class="flat-list">
				<a href="/audio/jreast/keiyo" class="flat-card" style="border-left: 6px solid #c92334;">
					<div>
						<span style="font-size: 0.75rem; color: #c92334; font-weight: 900; display: block; letter-spacing: 0.5px;">JE KEIYO LINE</span>
						<span>京葉線</span>
					</div>
					<span style="color: var(--text-sub); font-size: 0.85rem;">駅一覧へ ◀</span>
				</a>

				<a href="#" class="flat-card" style="border-left: 6px solid #ff7e00; opacity: 0.6;">
					<div>
						<span style="font-size: 0.75rem; color: #ff7e00; font-weight: 900; display: block;">JT TOKAIDO LINE</span>
						<span>東海道線</span>
					</div>
					<span style="color: var(--text-sub); font-size: 0.8rem;">準備中</span>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>