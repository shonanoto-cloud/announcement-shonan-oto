---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE } from '../../../consts';

// 駅個別の情報を管理するオブジェクト
const stationConfig = {
  pageTitle: "東京駅 発車メロディ案内",
  lineName: "京葉線",
  lineColor: "#c92334",
  stationName: "東京",
  stationEn: "Tokyo",
  stationNumber: "JE 01",
};
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{stationConfig.pageTitle}</title>
    <style define:vars={{ lineColor: stationConfig.lineColor }}>
        /* ==========================================================================
           1. デザインシステム（クリーン白ベース × サイネージのメリハリ）
           ========================================================================== */
        :root {
            --jr-green: #008024; /* JR東日本コーポレートカラー */
            --line-color: var(--lineColor); /* フロントマターの値を適用 */
            --bg-dark: #111827; /* ヘッダー用の引き締まった黒 */
            --bg-main: #f4f6f8; /* ボディ背景（見やすい薄グレー） */
            --card-white: #ffffff;
            --text-main: #1f2937; /* メイン文字色 */
            --text-sub: #4b5563; /* 補足文字色 */
            --border-light: #e5e8eb;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", "Hiragino Sans", sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
            display: flex;
            justify-content: center;
            width: 100%;
        }

        /* レスポンシブ対応コンテナ（スマホでは全幅、PCではスマートなカード風に） */
        .app-wrapper {
            width: 100%;
            max-width: 600px; /* 少し幅を広げて可読性を向上 */
            background: #ffffff;
            padding-bottom: 60px;
            box-shadow: 0 0 24px rgba(0,0,0,0.05);
        }

        /* ==========================================================================
           2. 駅サイネージ風ヘッダー
           ========================================================================== */
        .signage-header {
            background-color: var(--bg-dark);
            color: #ffffff;
            padding: 24px 16px;
            text-align: center;
            border-bottom: 6px solid var(--line-color); /* 下部に路線カラーの帯 */
            position: relative;
        }

        /* 隣の駅案内 */
        .neighbor-stations {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: #9ca3af;
            margin-bottom: 8px;
            font-weight: bold;
        }
        .neighbor-stations .prev::before { content: '◀ '; }
        .neighbor-stations .next::after { content: ' ▶'; }

        /* 駅ナンバリング */
        .station-badge {
            display: inline-block;
            border: 2px solid var(--line-color);
            background: #ffffff;
            color: var(--text-main);
            font-weight: 900;
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 0.8rem;
            margin-bottom: 8px;
        }
        .station-badge span {
            color: var(--line-color);
            margin-right: 2px;
        }

        /* 駅名表示 */
        .station-title-ja {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: 2px;
            line-height: 1.2;
        }
        .station-title-sub {
            font-size: 0.85rem;
            color: #9ca3af;
            margin-top: 4px;
        }

        /* ==========================================================================
           3. 大型写真エリア（レスポンス対応）
           ========================================================================== */
        .hero-gallery {
            width: 100%;
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            background: #000;
        }
        .hero-gallery::-webkit-scrollbar { display: none; }
        
        .hero-img-box {
            flex: 0 0 100%;
            scroll-snap-align: center;
            aspect-ratio: 16 / 9; /* より一般的な16:9比率に修正 */
        }
        .hero-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* ==========================================================================
           4. セクションタイトル
           ========================================================================== */
        .section-title {
            font-size: 1.1rem;
            font-weight: 800;
            padding: 24px 16px 10px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-main);
        }
        .section-title::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 1.1rem;
            background-color: var(--jr-green);
            border-radius: 2px;
        }

        /* 駅環境情報カード */
        .info-card {
            background: var(--card-white);
            margin: 0 16px;
            border-radius: 12px;
            padding: 16px;
            border: 1px solid var(--border-light);
            background-color: #f9fafb;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            font-size: 0.85rem;
        }
        .info-item-label {
            color: var(--text-sub);
            font-weight: bold;
            margin-bottom: 2px;
        }
        .info-item-value {
            font-weight: 700;
        }

        /* ==========================================================================
           5. 駅放送メイン・番線別セクション
           ========================================================================== */
        .platform-container {
            padding: 0 16px;
        }

        .platform-track-card {
            background: var(--card-white);
            margin-bottom: 24px;
            overflow: hidden;
        }

        .track-header {
            padding: 10px 0;
            border-bottom: 2px solid var(--text-main);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 16px;
            flex-wrap: wrap; /* 画面が狭い時に破綻しないよう折り返し許可 */
            gap: 4px;
        }
        .track-title {
            font-weight: 900;
            font-size: 1.2rem;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .track-title::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 1.2rem;
            background-color: var(--line-color);
        }
        .track-destination {
            font-size: 0.85rem;
            color: var(--text-sub);
            font-weight: 700;
        }

        .track-body {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .audio-row {
            background: #f8fafc;
            border-radius: 8px;
            padding: 14px;
            border: 1px solid #edf2f7;
        }

        .audio-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 8px;
        }
        .tag {
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            background: #e2e8f0;
            color: #4a5568;
        }
        .tag.accent {
            background: #e6f4ea;
            color: var(--jr-green);
        }

        .audio-heading {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
        }
        .audio-subname {
            font-size: 0.8rem;
            color: var(--text-sub);
            font-weight: normal;
        }

        audio {
            width: 100%;
            height: 40px; /* 少し押しやすく高さを調整 */
            margin-top: 4px;
            display: block; /* 隙間をなくす */
        }

        .audio-details {
            font-size: 0.8rem;
            color: #4b5563;
            line-height: 1.6;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px dashed #e2e8f0;
        }

        /* ==========================================================================
           6. フッターボタン
           ========================================================================== */
        .footer-nav {
            padding: 20px 16px;
        }
        .btn-app-back {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 48px;
            background-color: var(--card-white);
            color: var(--text-main);
            border: 2px solid var(--text-main);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            border-radius: 24px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            transition: all 0.2s;
        }
        .btn-app-back:hover {
            background-color: var(--bg-dark);
            color: #ffffff;
        }
    </style>
</head>
<body>
<Header />
<main>
    <div class="app-wrapper">
        
        <div class="signage-header">
            <div class="neighbor-stations">
                <span class="prev">当駅終着</span>
                <span class="next">八丁堀</span>
            </div>
            
            <div class="station-badge">
                <span>{stationConfig.stationNumber.split(' ')[0]}</span>{stationConfig.stationNumber.split(' ')[1]}
            </div>
 
            <h1 class="station-title-ja">{stationConfig.stationName}（{stationConfig.lineName}地下ホーム）</h1>
            <p class="station-title-sub">{stationConfig.stationEn} / 도쿄 / 东京</p>
        </div>

        <div class="hero-gallery">
            <div class="hero-img-box">
                <img src="https://picsum.photos/id/1015/800/500" alt="駅写真1">
            </div>
            <div class="hero-img-box">
                <img src="https://picsum.photos/id/1016/800/500" alt="駅写真2">
            </div>
        </div>

        <div class="section-title">駅スピーカー・環境情報</div>
        <div class="info-card">
            <div class="info-grid">
                <div>
                    <p class="info-item-label">密着集音難易度</p>
                    <p class="info-item-value" style="color: #ff9f43;">★★★☆☆ (普通)</p>
                </div>
                <div>
                    <p class="info-item-label">主なスピーカー型番</p>
                    <p class="info-item-value">BOSE / CLARITY</p>
                </div>
                <div>
                    <p class="info-item-label">放送システム</p>
                    <p class="info-item-value">宇都宮型・新音源</p>
                </div>
                <div>
                    <p class="info-item-label">ホーム環境</p>
                    <p class="info-item-value">地下（反響強め）</p>
                </div>
            </div>
        </div>

        <div class="section-title">番線別 駅放送・発車メロディ</div>
        <div class="platform-container">

            <div class="platform-track-card">
                <div class="track-header">
                    <span class="track-title">1・2番線ホーム</span>
                    <span class="track-destination">舞浜・海浜幕張・蘇我方面</span>
                </div>
                
                <div class="track-body">
                    <div class="audio-row">
                        <div class="audio-tags">
                            <span class="tag accent">接近放送</span>
                            <span class="tag">向山佳比子 氏</span>
                            <span class="tag">音質：良</span>
                        </div>
                        <div class="audio-heading">
                            <span>自動案内放送</span>
                            <span class="audio-subname">宇都宮型標準</span>
                        </div>
                        <audio controls src="announcement1.mp3"></audio>
                        <div class="audio-details">
                            地下ホーム特有の「ワンワン」という強い反響を抑えるため、スピーカー直下での密着収録を推奨します。前後のアナウンスの間隔が短めなのが特徴です。
                        </div>
                    </div>

                    <div class="audio-row">
                        <div class="audio-tags">
                            <span class="tag accent">発車メロディ</span>
                            <span class="tag">スイッチ製</span>
                            <span class="tag">鳴りやすさ：高</span>
                        </div>
                        <div class="audio-heading">
                            <span>Verde Rayo V2</span>
                            <span class="audio-subname">定番アレンジ</span>
                        </div>
                        <audio controls src="melody1.mp3"></audio>
                        <div class="audio-details">
                            始発列車となるため、ラッシュ時以外でも比較的長めのコーラスが鳴りやすい環境です。2ターン目に入ることも珍しくありません。
                        </div>
                    </div>
                </div>
            </div>

            <div class="platform-track-card">
                <div class="track-header">
                    <span class="track-title">3・4番線ホーム</span>
                    <span class="track-destination">武蔵野線直通・特急方面</span>
                </div>
                
                <div class="track-body">
                    <div class="audio-row">
                        <div class="audio-tags">
                            <span class="tag accent">始発・戸閉放送</span>
                            <span class="tag">田中一永 氏</span>
                        </div>
                        <div class="audio-heading">
                            <span>自動案内放送＋戸閉連動</span>
                            <span class="audio-subname">特急対応・予告あり</span>
                        </div>
                        <audio controls src="announcement3.mp3"></audio>
                        <div class="audio-details">
                            特急列車の入線時には、専用のスクロール表示と連動した長い案内放送が流れます。発車間際の「ドアが閉まります」まで綺麗に収録が可能です。
                        </div>
                    </div>

                    <div class="audio-row">
                        <div class="audio-tags">
                            <span class="tag accent">発車メロディ</span>
                            <span class="tag">スイッチ製</span>
                            <span class="tag">鳴りやすさ：中</span>
                        </div>
                        <div class="audio-heading">
                            <span>Verde Rayo V2</span>
                            <span class="audio-subname">1・2番線と同曲</span>
                        </div>
                        <audio controls src="melody3.mp3"></audio>
                        <div class="audio-details">
                            武蔵野線直通の普通列車や特急などバラエティ豊かな車両が発車します。乗降客数によって鳴動時間が大きく変動するため、粘り強い収録が必要です。
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="footer-nav">
            <a href="keiyo.html" class="btn-app-back">
                路線別へ戻る
            </a>
        </div>

    </div>
</main>
<Footer />
</body>
</html>