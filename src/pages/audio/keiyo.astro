// 3. 終端の接続路線リンクデータ
const transfers = [
  { name: "外房線", url: "https://example.com/sotobo", color: "#c92334" },
  { name: "内房線", url: "https://example.com/uchibo", color: "#0070bc" }
];
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={pageTitle} description={pageTitle} />
	<style define:vars={{ lineColor }}>
		/* 既存のglobal.cssを上書き・拡張するページ個別スタイル */
		
		/* タイムラインの土台設定（左側の線用スペース） */
		.station-timeline-container {
			padding-left: 32px;
			position: relative;
		}

		/* 左側に絶対配置する縦線（Astroの変数から色を取得） */
		.route-line {
			left: 12px;
			background-color: var(--lineColor);
			width: 6px;
			position: absolute;
			top: 20px;
			bottom: 20px;
			z-index: 1;
		}

		/* 各駅のカード。global.cssの互い違い背景のロジックを踏襲しつつ、スマホ対応 */
		.station-card {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			background-color: #ffffff;
			border: 1px solid #e1e5e8;
			border-radius: 8px;
			padding: 16px;
			gap: 12px;
			position: relative;
		}
		
		/* 奇数行の背景を少しトーンダウン（test2.htmlの美しい互い違いを継承） */
		.station-item:nth-child(odd) .station-card {
			background-color: #f4f5f8;
		}

		/* 路線上の丸ポチ（路線のラインに重なるように配置） */
		.station-dot {
			position: absolute;
			left: -23px; /* タイムラインのpaddingと連動して線の真上に配置 */
			top: 24px;
			width: 12px;
			height: 12px;
			background-color: #ffffff;
			border: 3px solid var(--lineColor);
			border-radius: 50%;
			z-index: 3;
		}

		/* ナンバリングのコンテナ */
		.station-number {
			display: inline-flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			border: 2px solid var(--lineColor);
			border-radius: 4px;
			min-width: 36px;
			height: 36px;
			font-size: 0.65rem;
			font-weight: bold;
			line-height: 1.1;
			background-color: #ffffff;
			flex-shrink: 0;
		}
		.station-number div {
			font-size: 0.9rem;
			font-weight: 800;
		}

		/* 駅名（矢印アニメーション付き） */
		.station-name {
			font-size: 1.2rem;
			font-weight: bold;
			color: #1a2530;
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			gap: 4px;
		}
		.station-name::after {
			content: '›';
			color: #2ca85a;
			font-size: 1.4rem;
			line-height: 1;
			transition: transform 0.2s ease;
		</style>
</head>
<body>
	<Header />
	<main>
		<div class="route-header">
			<span class="route-badge" style={`background-color: ${lineColor};`}>{routeBadgeText}</span>
			<div>
				<h1 class="route-title-main">{lineName}</h1>
				<p class="route-title-sub">発車メロディ・駅一覧</p>
			</div>
		</div>

		<div class="station-timeline-container">
			<div class="route-line"></div>

			{stations.map((station) => (
				<div class="station-item" style="position: relative;">
					<div class="station-dot"></div>
					
					<div class="station-card">
						<div class="station-info" style="flex-direction: column; align-items: flex-start; gap: 8px;">
							<div style="display: flex; align-items: center; gap: 12px;">
								<div class="station-number">
									{routeBadgeText}<div>{station.id}</div>
								</div>
								<a href="#" class="station-name">{station.name}</a>
							</div>

							<div class="melody-container">
								{station.melodies.map((m) => (
									<div class="melody-row">
										<span class="track-badge" style={`background-color: ${m.bg}; color: #fff;`}>
											{m.track}
										</span>
										<span class="melody-name">{m.name}</span>
									</div>
								))}
							</div>
						</div>

						{station.feature && (
							<div class="station-features">
								<div class="feature-card" style="position: relative;">
									<span class="card-tag" style={`background-color: ${station.feature.color}; color: ${station.feature.textColor};`}>
										{station.feature.tag}
									</span>
									<div class="card-text" set:html={station.feature.text}></div>
								</div>
							</div>
						)}
					</div>
				</div>
			))}

			<div class="footer-terminal">
				<div class="transfer-container">
					{transfers.map((t) => (
						<a href={t.url} class="transfer-button" style={`border-color: ${t.color}; color: ${t.color};`}>
							{t.name} <span>❯</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</main>
	<Footer />
</body>
</html>

<style is:global>
	/* 元のtest2.htmlにあったhover矢印アニメーションをレスポンシブに統合 */
	.station-name:hover::after {
		transform: translateX(4px);
	}

	/* 横幅が狭いスマホ表示における微調整 */
	@media (max-width: 480px) {
		.station-card {
			flex-direction: row; /* 横並びを維持 */
			align-items: center;
			padding: 12px 8px;
		}
		.melody-name {
			font-size: 0.75rem;
			max-width: 140px;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.feature-card {
			min-width: 58px;
			padding: 4px;
		}
		.card-text {
			font-size: 0.65rem;
		}
	}
</style>