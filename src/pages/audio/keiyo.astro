---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const lineColor = "#c92334"; // 京葉線赤
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`京葉線 駅一覧 | ${SITE_TITLE}`} description="京葉線の収録駅一覧ページです。" />
		<style define:vars={{ lineColor }}>
			/* 縦の路線図を表現するライン */
			.station-timeline {
				position: relative;
				padding: 8px 16px;
				display: flex;
				flex-direction: column;
				gap: 0; /* 密着させて路線図っぽく見せる */
			}
			.station-row {
				display: flex;
				align-items: center;
				text-decoration: none;
				color: var(--text-main);
				padding: 14px 16px;
				border: 1px solid var(--border-light);
				border-top: none;
				background: #ffffff;
				position: relative;
				transition: background 0.2s;
			}
			.station-row:first-child {
				border-top: 1px solid var(--border-light);
			}
			.station-row:hover {
				background: #f9fafb;
			}
			
			/* ナンバリング用のシャープな角丸なし四角バッジ */
			.station-badge-flat {
				border: 2px solid var(--lineColor);
				background: #ffffff;
				color: var(--text-main);
				font-weight: 900;
				padding: 2px 6px;
				font-size: 0.75rem;
				min-width: 48px;
				text-align: center;
				margin-right: 16px;
			}
			.station-badge-flat span {
				color: var(--lineColor);
				margin-right: 1px;
			}
			
			.station-name-ja {
				font-weight: 800;
				font-size: 1.05rem;
				letter-spacing: 0.5px;
			}
			.station-name-en {
				font-size: 0.75rem;
				color: var(--text-sub);
				margin-left: 8px;
				font-weight: 600;
			}
			.arrow-mark {
				margin-left: auto;
				color: var(--text-sub);
				font-size: 0.85rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="main-container">
			<div class="section-title">京葉線 駅一覧</div>
			
			<div class="station-timeline">
				<a href="/audio/jreast/keiyo/tokyo" class="station-row" style="border-left: 4px solid var(--lineColor);">
					<div class="station-badge-flat"><span>JE</span>01</div>
					<div>
						<span class="station-name-ja">東京</span>
						<span class="station-name-en">Tōkyō</span>
					</div>
					<span class="arrow-mark">詳細へ ◀</span>
				</a>

				<a href="#" class="station-row" style="border-left: 4px solid var(--lineColor); opacity: 0.5;">
					<div class="station-badge-flat"><span>JE</span>02</div>
					<div>
						<span class="station-name-ja">八丁堀</span>
						<span class="station-name-en">Hatchōbori</span>
					</div>
					<span class="arrow-mark">準備中</span>
				</a>

				<a href="#" class="station-row" style="border-left: 4px solid var(--lineColor); opacity: 0.5;">
					<div class="station-badge-flat"><span>JE</span>03</div>
					<div>
						<span class="station-name-ja">越中島</span>
						<span class="station-name-en">Etchūjima</span>
					</div>
					<span class="arrow-mark">準備中</span>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>