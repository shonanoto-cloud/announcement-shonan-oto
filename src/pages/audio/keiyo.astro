---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

// ==========================================================================
// 路線個別カスタマイズオプション（別の路線を作る時はここを変更）
// ==========================================================================
const lineColor = "#c92334";       // 京葉線ラインカラー（赤）
const routeBadgeText = "JE";        // 路線記号
const bgLight = "#f4f5f8";          // 駅背景の互い違い色1
const bgDark = "#ffffff";           // 駅背景の互い違い色2
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`京葉線 路線案内 | ${SITE_TITLE}`} description="京葉線の発車メロディ＆路線案内" />
		
		<style define:vars={{ lineColor, bgLight, bgDark }}>
			/* ページごとの固有色をCSS変数に割り当て */
			.route-badge {
				background-color: var(--lineColor);
			}
			.route-line {
				background-color: var(--lineColor);
				/* タイムラインの丸ポチ（34px付近）の真下にラインが通るようPC・スマホ共通で自動計算 */
				left: 43px; 
			}
			/* 偶数・奇数の駅カードの背景色を入れ替え */
			.station-card:nth-child(odd) {
				background-color: var(--bgLight);
			}
			.station-card:nth-child(even) {
				background-color: var(--bgDark);
			}
		</style>
	</head>
	<body>
		<Header />
		
		<div class="route-page-wrapper">
			
			<div class="route-header">
				<div class="route-badge">{routeBadgeText}</div>
				<div>
					<h1 class="route-title-main">京葉線</h1>
					<p class="route-title-sub">KEIYO LINE</p>
				</div>
			</div>

			<div class="station-timeline-container">
				<div class="route-line"></div>

				<div class="station-card">
					<div class="station-info">
						<div class="station-number">{routeBadgeText}<div>01</div></div>
						<div>
							<a href="/audio/jreast/keiyo/tokyo" class="station-name">東京</a>
							<div class="melody-container">
								<div class="melody-row">
									<span class="track-badge">1〜4番線</span>
									<span class="melody-name">Verde Rayo V2 など</span>
								</div>
							</div>
						</div>
					</div>
					<div class="station-features">
						<div class="feature-card">
							<span class="card-tag" style="background-color: #008024;">始発</span>
							<div class="card-text">特急・各停<br>快速</div>
						</div>
						<div class="feature-card">
							<span class="card-tag" style="background-color: #616d7a;">乗換</span>
							<div class="card-text">山手・中央<br>新幹線 他</div>
						</div>
					</div>
				</div>

				<div class="station-card">
					<div class="station-info">
						<div class="station-number">{routeBadgeText}<div>02</div></div>
						<div>
							<a href="#" class="station-name">八丁堀</a>
							<div class="melody-container">
								<div class="melody-row">
									<span class="track-badge">1番線</span>
									<span class="melody-name">Over</span>
								</div>
								<div class="melody-row">
									<span class="track-badge">2番線</span>
									<span class="melody-name">シンコペーション</span>
								</div>
							</div>
						</div>
					</div>
					<div class="station-features">
						<div class="feature-card">
							<span class="card-tag" style="background-color: #616d7a;">乗換</span>
							<div class="card-text">日比谷線</div>
						</div>
					</div>
				</div>

				<div class="station-card">
					<div class="station-info">
						<div class="station-number">{routeBadgeText}<div>17</div></div>
						<div>
							<a href="#" class="station-name">蘇我</a>
							<div class="melody-container">
								<div class="melody-row">
									<span class="track-badge">3・4番線</span>
									<span class="melody-name">Over</span>
								</div>
							</div>
						</div>
					</div>
					<div class="station-features">
						<div class="feature-card">
							<span class="card-tag" style="background-color: #e24a00;">注意</span>
							<div class="card-text">当駅始発・<br>終着多数</div>
						</div>
					</div>
				</div>

			</div> <div class="footer-terminal">
				<div class="route-line"></div>
				<div class="transfer-container">
					<a href="#" class="transfer-button" style="border-color: #c92334; color: #c92334;">
						外房線 <span>❯</span>
					</a>
					<a href="#" class="transfer-button" style="border-color: #0070bc; color: #0070bc;">
						内房線 <span>❯</span>
					</a>
				</div>
			</div>

		</div> <Footer />
	</body>
</html>