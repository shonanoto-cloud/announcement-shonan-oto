---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

// ==========================================================================
// 路線別カスタマイズカラー（他の路線を作る時はここだけ変えればOK！）
// ==========================================================================
const lineColor = "#c92334"; // 京葉線のラインカラー（赤）
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`京葉線 路線案内 | ${SITE_TITLE}`} description="京葉線の駅一覧と発車メロディ案内" />
		<style define:vars={{ lineColor }}>
			/* keiyo.astro 個別のカラーマッピング */
			.route-line-core {
				background-color: var(--lineColor);
			}
			.station-id-badge {
				color: var(--lineColor);
			}
			/* 路線図の縦棒の位置をナンバリングの真後ろに綺麗にPC最適化 */
			.route-line-core {
				left: 14px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="max-width: 100%; padding: 20px 16px;">
			
			<div class="route-board-container">
				
				<h2 style="margin-top: 0; margin-bottom: 24px; font-size: 1.6rem; font-weight: 900; display: flex; align-items: center; gap: 12px;">
					<span style={`display: inline-block; width: 8px; height: 1.6rem; background-color: ${lineColor}; border-radius: 4px;`}></span>
					京葉線 駅一覧・メロディ案内
				</h2>

				<div class="route-map-vertical">
					<div class="route-line-core"></div>

					<div class="station-row-item">
						<div class="station-left-box">
							<div class="station-id-badge">JE<div>01</div></div>
							<a href="/audio/jreast/keiyo/tokyo" class="station-name-link">東京</a>
							
							<div class="station-melody-block">
								<div class="melody-track-line">
									<span class="track-badge">1〜4番線</span>
									<span class="melody-title-text">Verde Rayo V2</span>
								</div>
							</div>
						</div>
						<div class="station-right-box">
							<div class="feature-info-card">
								<span class="feature-tag-pill" style="background-color: #008024;">始発</span>
								<div class="feature-desc-text">地下ホーム<br>全列車始発</div>
							</div>
						</div>
					</div>

					<div class="station-row-item">
						<div class="station-left-box">
							<div class="station-id-badge">JE<div>02</div></div>
							<a href="#" class="station-name-link">八丁堀</a>
							
							<div class="station-melody-block">
								<div class="melody-track-line">
									<span class="track-badge">1番線</span>
									<span class="melody-title-text">Over</span>
								</div>
								<div class="melody-track-line">
									<span class="track-badge">2番線</span>
									<span class="melody-title-text">シンコペーション</span>
								</div>
							</div>
						</div>
						<div class="station-right-box">
							</div>
					</div>

					<div class="station-row-item">
						<div class="station-left-box">
							<div class="station-id-badge">JE<div>17</div></div>
							<a href="#" class="station-name-link">蘇我</a>
							
							<div class="station-melody-block">
								<div class="melody-track-line">
									<span class="track-badge">3・4番線</span>
									<span class="melody-title-text">Over</span>
								</div>
							</div>
						</div>
						<div class="station-right-box">
							<div class="feature-info-card">
								<span class="feature-tag-pill" style="background-color: #e24a00;">注意</span>
								<div class="feature-desc-text">当駅始発・<br>終着多数</div>
							</div>
						</div>
					</div>

					<div class="route-footer-terminal">
						<div class="transfer-buttons-wrapper">
							<a href="#" class="transfer-route-btn" style="border-color: #c92334; color: #c92334;">
								外房線 <span>❯</span>
							</a>
							<a href="#" class="transfer-route-btn" style="border-color: #0070bc; color: #0070bc;">
								内房線 <span>❯</span>
							</a>
						</div>
					</div>

				</div>
			</div>

		</main>
		<Footer />
	</body>
</html>